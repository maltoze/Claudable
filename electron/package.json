{
  "name": "claudable-electron",
  "productName": "Claudable",
  "version": "1.0.0",
  "description": "AI-powered code generation and project management desktop application",
  "main": "main.js",
  "author": "Claudable Team",
  "license": "MIT",
  "private": true,
  "homepage": ".",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=true electron .",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "dist": "electron-forge make",
    "dist:mac": "electron-forge make --platform=darwin",
    "dist:win": "electron-forge make --platform=win32",
    "dist:linux": "electron-forge make --platform=linux",
    "build": "npm run build:web && npm run build:api",
    "build:web": "cd ../apps/web && npm run build",
    "build:api": "cd ../apps/api && python build_binary.py"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-deb": "^7.9.0",
    "@electron-forge/maker-dmg": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.9.0",
    "@electron-forge/plugin-fuses": "^7.9.0",
    "@electron-forge/publisher-github": "^7.9.0",
    "@electron/fuses": "^1.8.0",
    "electron": "^28.1.0"
  }
}
